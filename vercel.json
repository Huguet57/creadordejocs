{
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "npm run editor:build",
  "outputDirectory": "apps/editor/dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.simplegamecreator.com" }],
      "destination": "https://simplegamecreator.com",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.simplegamecreator.com" }],
      "destination": "https://simplegamecreator.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.creadordejuegos.com" }],
      "destination": "https://creadordejuegos.com",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.creadordejuegos.com" }],
      "destination": "https://creadordejuegos.com/:path*",
      "permanent": true
    },
    {
      "source": "/es",
      "has": [{ "type": "host", "value": "creadordejocs.cat" }],
      "destination": "https://creadordejuegos.com",
      "permanent": true
    },
    {
      "source": "/es",
      "has": [{ "type": "host", "value": "www.creadordejocs.cat" }],
      "destination": "https://creadordejuegos.com",
      "permanent": true
    },
    {
      "source": "/es/:path*",
      "has": [{ "type": "host", "value": "creadordejocs.cat" }],
      "destination": "https://creadordejuegos.com/:path*",
      "permanent": true
    },
    {
      "source": "/es/:path*",
      "has": [{ "type": "host", "value": "www.creadordejocs.cat" }],
      "destination": "https://creadordejuegos.com/:path*",
      "permanent": true
    },
    {
      "source": "/en",
      "has": [{ "type": "host", "value": "creadordejocs.cat" }],
      "destination": "https://simplegamecreator.com",
      "permanent": true
    },
    {
      "source": "/en",
      "has": [{ "type": "host", "value": "www.creadordejocs.cat" }],
      "destination": "https://simplegamecreator.com",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "has": [{ "type": "host", "value": "creadordejocs.cat" }],
      "destination": "https://simplegamecreator.com/:path*",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "has": [{ "type": "host", "value": "www.creadordejocs.cat" }],
      "destination": "https://simplegamecreator.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "creadordejocs.cat" }], "destination": "/ca/index.html" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.creadordejocs.cat" }],
      "destination": "/ca/index.html"
    },
    {
      "source": "/editor",
      "has": [{ "type": "host", "value": "creadordejocs.cat" }],
      "destination": "/ca/index.html"
    },
    {
      "source": "/editor",
      "has": [{ "type": "host", "value": "www.creadordejocs.cat" }],
      "destination": "/ca/index.html"
    },
    {
      "source": "/editor/:path*",
      "has": [{ "type": "host", "value": "creadordejocs.cat" }],
      "destination": "/ca/index.html"
    },
    {
      "source": "/editor/:path*",
      "has": [{ "type": "host", "value": "www.creadordejocs.cat" }],
      "destination": "/ca/index.html"
    },
    {
      "source": "/play/:id",
      "has": [{ "type": "host", "value": "creadordejocs.cat" }],
      "destination": "/ca/index.html"
    },
    {
      "source": "/play/:id",
      "has": [{ "type": "host", "value": "www.creadordejocs.cat" }],
      "destination": "/ca/index.html"
    },

    {
      "source": "/",
      "has": [{ "type": "host", "value": "creadordejuegos.com" }],
      "destination": "/es/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.creadordejuegos.com" }],
      "destination": "/es/index.html"
    },
    {
      "source": "/editor",
      "has": [{ "type": "host", "value": "creadordejuegos.com" }],
      "destination": "/es/index.html"
    },
    {
      "source": "/editor",
      "has": [{ "type": "host", "value": "www.creadordejuegos.com" }],
      "destination": "/es/index.html"
    },
    {
      "source": "/editor/:path*",
      "has": [{ "type": "host", "value": "creadordejuegos.com" }],
      "destination": "/es/index.html"
    },
    {
      "source": "/editor/:path*",
      "has": [{ "type": "host", "value": "www.creadordejuegos.com" }],
      "destination": "/es/index.html"
    },
    {
      "source": "/play/:id",
      "has": [{ "type": "host", "value": "creadordejuegos.com" }],
      "destination": "/es/index.html"
    },
    {
      "source": "/play/:id",
      "has": [{ "type": "host", "value": "www.creadordejuegos.com" }],
      "destination": "/es/index.html"
    },

    {
      "source": "/",
      "has": [{ "type": "host", "value": "simplegamecreator.com" }],
      "destination": "/en/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.simplegamecreator.com" }],
      "destination": "/en/index.html"
    },
    {
      "source": "/editor",
      "has": [{ "type": "host", "value": "simplegamecreator.com" }],
      "destination": "/en/index.html"
    },
    {
      "source": "/editor",
      "has": [{ "type": "host", "value": "www.simplegamecreator.com" }],
      "destination": "/en/index.html"
    },
    {
      "source": "/editor/:path*",
      "has": [{ "type": "host", "value": "simplegamecreator.com" }],
      "destination": "/en/index.html"
    },
    {
      "source": "/editor/:path*",
      "has": [{ "type": "host", "value": "www.simplegamecreator.com" }],
      "destination": "/en/index.html"
    },
    {
      "source": "/play/:id",
      "has": [{ "type": "host", "value": "simplegamecreator.com" }],
      "destination": "/en/index.html"
    },
    {
      "source": "/play/:id",
      "has": [{ "type": "host", "value": "www.simplegamecreator.com" }],
      "destination": "/en/index.html"
    },

    { "source": "/", "destination": "/en/index.html" },
    { "source": "/editor", "destination": "/en/index.html" },
    { "source": "/editor/:path*", "destination": "/en/index.html" },
    { "source": "/play/:id", "destination": "/en/index.html" }
  ]
}
